<?xml version="1.0" encoding="UTF-8"?>
<!-- PrivacyInfo.xcprivacy — required-reason API declarations for the current native target. On-device Whisper audio is
     not uploaded for transcription. Data-collection declarations and App Store privacy answers still require a release
     inventory of every retained backend field; this file must not be treated as proof that account-linked app traffic
     is outside Apple's collection definitions. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- We do NOT track users across apps/websites. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <!-- Provisional until the backend-retention inventory is approved; never infer App Store privacy answers from this
         empty array. The release gate must update this declaration if retained account/device/content fields qualify. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!-- Required-reason APIs actually used. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- UserDefaults (CA92.1 = the app's own settings/config, e.g. the gateway URL config value). -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- Sleep-inclusive monotonic time counts down a server-issued Registry V2 lease and detects clock/reboot
                 discontinuity. It remains on-device and is never used for fingerprinting (35F9.1 = elapsed timers). -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
